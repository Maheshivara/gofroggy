#!/bin/sh

ARGS=$(mktemp) || exit 1
trap 'rm -f "$ARGS"' EXIT HUP INT TERM

for arg do
    case "$arg" in
        -march=*|-mips32|-mips32r2|-mips32r3|-mips32r5|-mips32r6|-mhard-float|-msoft-float)
            ;;
        *)
            printf '%s\n' "$arg" >> "$ARGS"
            ;;
    esac
done

set --
while IFS= read -r arg; do
    set -- "$@" "$arg"
done < "$ARGS"

rm -f "$ARGS"
trap - EXIT HUP INT TERM

TOOLCHAIN=/opt/mipsel-buildroot-linux-gnu_sdk-buildroot
GCC="$TOOLCHAIN/bin/mips-mti-linux-gnu-gcc"
SYSROOT="$TOOLCHAIN/opt/ext-toolchain/sysroot"
HARDROOT="$SYSROOT/mipsel-r2-hard"

exec "$GCC" \
    "$@" \
    -EL \
    -march=mips32r2 \
    -mhard-float \
    --sysroot="$SYSROOT" \
    -isystem "$HARDROOT/usr/include" \
    -B"$HARDROOT/usr/lib/" \
    -L"$HARDROOT/usr/lib" \
    -L"$HARDROOT/lib" \
    -Wl,--sysroot="$SYSROOT"
